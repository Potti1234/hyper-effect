{
  "name": "@hyper-effect/example-admin",
  "version": "0.0.0",
  "private": true,
  "description": "Catalog admin: a CRUD app with sign-in and roles, search, filters, sorting and pagination synced to the URL, image uploads, and live updates across editors.",
  "type": "module",
  "scripts": {
    "dev": "npm run css && tsx watch src/main.ts",
    "start": "npm run css && tsx src/main.ts",
    "css": "tailwindcss -i src/styles.css -o public/styles.css",
    "typecheck": "tsc --noEmit",
    "check:admin": "node scripts/admin-check.mjs ../../output/admin-check 300"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/sql-pg": "4.1.2",
    "@foldkit/ui": "0.170.0",
    "@hyper-effect/core": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.1"
  }
}
