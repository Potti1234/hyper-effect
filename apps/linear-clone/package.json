{
  "name": "linear-clone",
  "version": "0.0.0",
  "private": true,
  "description": "Linear: a hyper-effect app.",
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx watch src/main.ts",
    "start": "npm run build && node --import tsx src/main.ts",
    "build": "npm run css",
    "css": "tailwindcss -i src/styles.css -o public/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@foldkit/ui": "0.170.0",
    "@hyper-effect/core": "0.1.0-alpha.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@tailwindcss/cli": "^4.3.1",
    "@types/node": "^22.0.0",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
